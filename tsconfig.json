{
  "compilerOptions": {
    "target": "ES2022",
    // DOM comes along for IndexedDB's declarations, which matrix-js-sdk's
    // crypto store types reach for through @prinny/bot.
    "lib": ["ES2023", "DOM"],
    // TypeScript 6 stopped auto-including every `@types/*` package it can
    // find; without this, `Buffer` and the `node:*` modules resolve to nothing.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["plugin/src/**/*.ts", "test/**/*.ts"]
}
