# Copied to <state-dir>/.env by /prinny:configure. Real environment wins over
# this file, so exporting any of these in your shell overrides it.
#
# Default state dir: ~/.claude/channels/prinny
# Override with PRINNY_STATE_DIR to run several bots on one machine.

PRINNY_HOMESERVER=https://matrix.example.org
PRINNY_USER_ID=@claude:example.org

# Password login mints an access token on first boot and writes it back here.
# Keep the password for at least one boot: cross-signing needs user-interactive
# auth, and without it modern clients exclude the bot from key sharing.
PRINNY_PASSWORD=

# Written by the server after a successful password login.
# PRINNY_ACCESS_TOKEN=
# PRINNY_DEVICE_ID=

# Encrypts the crypto store at rest. A store is not portable across a change to
# this value — set it once, before first boot, or not at all.
# PRINNY_STORE_PASSPHRASE=

# Start the bot even if end-to-end encryption fails to initialise. Off by
# default, and it should stay off.
# PRINNY_ALLOW_UNENCRYPTED=1

# Pin access config to what was on disk at boot. Pairing is unavailable in
# static mode, since it needs runtime writes.
# PRINNY_ACCESS_MODE=static
